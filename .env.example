# PIE ERP source configuration
ERP_FRONTEND_PATH="./data/erp/frontend"
ERP_BACKEND_PATH="./data/erp/backend"

# SQL Server metadata connection (schema/metadata only is required)
DATABASE_URL="mssql+pyodbc://USERNAME:PASSWORD@HOST/DATABASE?driver=ODBC+Driver+18+for+SQL+Server"
# Alternative DB_* variables are also supported by PIE.
# DB_HOST="192.168.0.10"
# DB_PORT="1433"
# DB_NAME="BASICTEST"
# DB_USER="USERNAME"
# DB_PASSWORD="PASSWORD"
# DB_DRIVER="ODBC Driver 18 for SQL Server"

# Optional LLM configuration used by earlier PIE phases
PIE_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"

# Phase outputs
PIE_DISCOVERY_OUTPUT="outputs/phase12-discovery"
PIE_DISCOVERY_REPORT="outputs/phase12-discovery/erp_discovery_report.json"
PIE_IDENTITY_OUTPUT="outputs/phase13-identity"
PIE_IDENTITY_REGISTRY="outputs/phase13-identity/screen_registry_v13.json"
PIE_API_MAPPING_OUTPUT="outputs/phase14-api-mapping"
PIE_API_MAPPING_REGISTRY="outputs/phase14-api-mapping/screen_api_backend_mapping_v14.json"
PIE_DB_MAPPING_OUTPUT="outputs/phase15-db-mapping"
PIE_KMS_PATH="./outputs/kms"
PIE_EVIDENCE_GRAPH="outputs/phase16-evidence-graph/evidence_graph_v16.json"
PIE_AI_KNOWLEDGE_OUTPUT="outputs/phase17-ai-knowledge"
PIE_AI_WORKERS="1"

# v0.18 Qdrant KMS
QDRANT_URL=http://217.217.249.121:6333
QDRANT_COLLECTION=pie_knowledge
QDRANT_API_KEY=
# Qdrant KMS is authoritative; v0.17 JSON is input/audit only.

# v0.25 all-in-one knowledge: semantic search (OpenAI embeddings + keyword vectors) and source code.
# Build pie_knowledge_v2 with `kms-migrate`, then point QDRANT_COLLECTION at it.
# PIE_EMBEDDINGS=openai
# PIE_EMBEDDING_MODEL=text-embedding-3-small
# PIE_CODE_COLLECTION=pie_code_v2

# v0.19 Marketing chat (Ask PIE): openai | azure_openai | offline
# Falls back to PIE_LLM_PROVIDER when not set.
PIE_CHAT_LLM_PROVIDER="openai"
PIE_LLM_TIMEOUT="90"
